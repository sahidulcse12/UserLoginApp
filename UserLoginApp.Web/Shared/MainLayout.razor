@inherits LayoutComponentBase
@inject ApiService Api
@inject UserContext UserCtx
@inject NavigationManager Navigation

<PageTitle>UserLogin App</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-white fw-semibold">User &amp; Access Control</span>
            <AuthorizeView>
                <Authorized>
                    <a href="/logout" class="btn btn-sm btn-outline-light">
                        Logout (@context.User.Identity!.Name)
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!UserCtx.IsLoaded)
        {
            var me = await Api.GetMeAsync();
            if (me != null)
                UserCtx.Load(me.Username, me.Features, me.Roles);
        }
    }
}

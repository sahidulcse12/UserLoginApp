@implements IDisposable
@inject UserContext UserCtx

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">AppControl</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                        <span class="oi oi-home" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>

                @if (UserCtx.HasFeature("USER_MANAGEMENT"))
                {
                    <div class="nav-item px-3 mt-2">
                        <span class="nav-link text-white-50 small text-uppercase px-0">Admin</span>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/users">
                            <span class="oi oi-people" aria-hidden="true"></span> Users
                        </NavLink>
                    </div>
                }

                @if (UserCtx.HasFeature("ROLE_MANAGEMENT"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/roles">
                            <span class="oi oi-key" aria-hidden="true"></span> Roles
                        </NavLink>
                    </div>
                }

                @if (UserCtx.HasFeature("CATEGORY_MANAGEMENT"))
                {
                    <div class="nav-item px-3 mt-2">
                        <span class="nav-link text-white-50 small text-uppercase px-0">Manager</span>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/categories">
                            <span class="oi oi-tags" aria-hidden="true"></span> Categories
                        </NavLink>
                    </div>
                }

                @if (UserCtx.HasFeature("PRODUCT_MANAGEMENT"))
                {
                    <div class="nav-item px-3 mt-2">
                        <span class="nav-link text-white-50 small text-uppercase px-0">Executive</span>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/products">
                            <span class="oi oi-box" aria-hidden="true"></span> Products
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    protected override void OnInitialized()
    {
        // Re-render this component whenever features are loaded by MainLayout
        UserCtx.OnChange += OnUserContextChanged;
    }

    private void OnUserContextChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UserCtx.OnChange -= OnUserContextChanged;
    }
}

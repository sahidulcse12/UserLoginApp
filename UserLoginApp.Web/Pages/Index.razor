@page "/"
@attribute [Authorize]
@implements IDisposable
@inject UserContext UserCtx
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<h4 class="mb-4">Dashboard</h4>

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <p class="text-muted mb-1">Welcome, <strong>@context.User.Identity!.Name</strong>. Use the navigation to access your features.</p>
                @if (UserCtx.Roles.Any())
                {
                    <span class="badge bg-primary me-1">@string.Join(", ", UserCtx.Roles)</span>
                }
            </div>
            <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
        </div>

        <div class="row g-3 mt-2">
            @if (context.User.HasClaim("feature", "USER_MANAGEMENT"))
            {
                <div class="col-md-3">
                    <a href="/users" class="card text-decoration-none text-dark h-100">
                        <div class="card-body text-center">
                            <div class="display-6 mb-2">👥</div>
                            <div class="fw-semibold">User Management</div>
                            <small class="text-muted">Create and manage system users</small>
                        </div>
                    </a>
                </div>
            }
            @if (context.User.HasClaim("feature", "ROLE_MANAGEMENT"))
            {
                <div class="col-md-3">
                    <a href="/roles" class="card text-decoration-none text-dark h-100">
                        <div class="card-body text-center">
                            <div class="display-6 mb-2">🔑</div>
                            <div class="fw-semibold">Role Management</div>
                            <small class="text-muted">Define roles and feature access</small>
                        </div>
                    </a>
                </div>
            }
            @if (context.User.HasClaim("feature", "CATEGORY_MANAGEMENT"))
            {
                <div class="col-md-3">
                    <a href="/categories" class="card text-decoration-none text-dark h-100">
                        <div class="card-body text-center">
                            <div class="display-6 mb-2">🏷️</div>
                            <div class="fw-semibold">Categories</div>
                            <small class="text-muted">Manage product categories</small>
                        </div>
                    </a>
                </div>
            }
            @if (context.User.HasClaim("feature", "PRODUCT_MANAGEMENT"))
            {
                <div class="col-md-3">
                    <a href="/products" class="card text-decoration-none text-dark h-100">
                        <div class="card-body text-center">
                            <div class="display-6 mb-2">📦</div>
                            <div class="fw-semibold">Products</div>
                            <small class="text-muted">Manage product entries</small>
                        </div>
                    </a>
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    protected override void OnInitialized()
    {
        UserCtx.OnChange += OnUserContextChanged;
    }

    private void OnUserContextChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        UserCtx.OnChange -= OnUserContextChanged;
    }
}

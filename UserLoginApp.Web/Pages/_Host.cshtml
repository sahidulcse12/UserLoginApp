@page "/"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Web
@using UserLoginApp.Web.Services
@namespace UserLoginApp.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject TokenProvider TokenProvider
@inject ServerTokenStore TokenStore

@{
    // During the initial HTTP request HttpContext is live — capture the Keycloak
    // access token and store it both in the request-scoped TokenProvider (for
    // pre-rendering) and in the singleton ServerTokenStore (for the circuit scope,
    // which is a separate DI scope that TokenCircuitHandler will populate later).
    var token = await HttpContext.GetTokenAsync("access_token");
    var sub   = HttpContext.User.FindFirst("sub")?.Value;

    TokenProvider.AccessToken = token;

    if (token != null && sub != null)
        TokenStore.Set(sub, token);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <title>UserLogin App</title>
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="UserLoginApp.Web.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>

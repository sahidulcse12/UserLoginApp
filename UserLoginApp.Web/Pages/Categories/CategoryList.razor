@page "/categories"
@attribute [Authorize]
@inject ApiService Api

<PageTitle>Categories</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Categories</h4>
    <a href="/categories/create" class="btn btn-primary btn-sm">+ New Category</a>
</div>

<div class="input-group mb-3" style="max-width:320px">
    <input class="form-control" placeholder="Search by name or code..." @bind="_search" @bind:event="oninput" @onkeyup="OnSearch" />
    <button class="btn btn-outline-secondary" @onclick="LoadCategories">Search</button>
</div>

@if (_loading)
{
    <div class="text-center py-4"><div class="spinner-border"></div></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Updated</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in _categories)
                {
                    <tr>
                        <td><code>@cat.Code</code></td>
                        <td>@cat.Name</td>
                        <td>
                            <span class="badge @(cat.IsActive ? "bg-success" : "bg-danger")">
                                @(cat.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@cat.CreatedAt.ToLocalTime().ToString("dd-MMM-yyyy")</td>
                        <td>@(cat.UpdatedAt.HasValue ? cat.UpdatedAt.Value.ToLocalTime().ToString("dd-MMM-yyyy") : "-")</td>
                        <td>
                            <a href="/categories/edit/@cat.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            @if (cat.IsActive)
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => SetActive(cat.Id, false)">Deactivate</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => SetActive(cat.Id, true)">Activate</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CategoryDto> _categories = new();
    private string _search = string.Empty;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadCategories();

    private async Task LoadCategories()
    {
        _loading = true;
        _categories = await Api.GetCategoriesAsync(_search);
        _loading = false;
    }

    private async Task OnSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadCategories();
    }

    private async Task SetActive(Guid id, bool active)
    {
        await Api.SetCategoryActiveAsync(id, active);
        await LoadCategories();
    }
}

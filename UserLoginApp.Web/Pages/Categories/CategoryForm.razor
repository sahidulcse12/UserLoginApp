@page "/categories/create"
@page "/categories/edit/{Id:guid}"
@attribute [Authorize]
@inject ApiService Api
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Edit Category" : "New Category")</PageTitle>

<div class="d-flex align-items-center mb-3">
    <a href="/categories" class="btn btn-sm btn-outline-secondary me-2">← Back</a>
    <h4 class="mb-0">@(IsEdit ? "Edit Category" : "New Category")</h4>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<div class="card" style="max-width:420px">
    <div class="card-body">
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Code <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="_model.Code" placeholder="e.g. ELEC" />
            </div>
            <div class="mb-3">
                <label class="form-label">Name <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="_model.Name" placeholder="e.g. Electronics" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_loading">
                    @if (_loading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    @(IsEdit ? "Save Changes" : "Create Category")
                </button>
                <a href="/categories" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEdit => Id.HasValue;
    private CategoryFormModel _model = new();
    private bool _loading;
    private string _error = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsEdit) return;
        var cat = await Api.GetCategoryAsync(Id!.Value);
        if (cat != null)
        {
            _model.Name = cat.Name;
            _model.Code = cat.Code;
        }
    }

    private async Task HandleSubmit()
    {
        _loading = true;
        _error = string.Empty;

        var (success, error) = IsEdit
            ? await Api.UpdateCategoryAsync(Id!.Value, _model)
            : await Api.CreateCategoryAsync(_model);

        if (success)
            Navigation.NavigateTo("/categories");
        else
            _error = string.IsNullOrEmpty(error) ? "An error occurred." : error;

        _loading = false;
    }
}

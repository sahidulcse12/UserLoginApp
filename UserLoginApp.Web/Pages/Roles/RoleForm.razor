@page "/roles/create"
@page "/roles/edit/{Id:guid}"
@attribute [Authorize]
@inject ApiService Api
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Edit Role" : "New Role")</PageTitle>

<div class="d-flex align-items-center mb-3">
    <a href="/roles" class="btn btn-sm btn-outline-secondary me-2">← Back</a>
    <h4 class="mb-0">@(IsEdit ? "Edit Role" : "New Role")</h4>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<div class="card" style="max-width:450px">
    <div class="card-body">
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Role Name <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="_model.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" @bind-Value="_model.Description" rows="3" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_loading">
                    @if (_loading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    @(IsEdit ? "Save Changes" : "Create Role")
                </button>
                <a href="/roles" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEdit => Id.HasValue;
    private RoleFormModel _model = new();
    private bool _loading;
    private string _error = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsEdit) return;
        var role = await Api.GetRoleAsync(Id!.Value);
        if (role != null)
        {
            _model.Name = role.Name;
            _model.Description = role.Description;
        }
    }

    private async Task HandleSubmit()
    {
        _loading = true;
        _error = string.Empty;

        var (success, error) = IsEdit
            ? await Api.UpdateRoleAsync(Id!.Value, _model)
            : await Api.CreateRoleAsync(_model);

        if (success)
            Navigation.NavigateTo("/roles");
        else
            _error = string.IsNullOrEmpty(error) ? "An error occurred." : error;

        _loading = false;
    }
}

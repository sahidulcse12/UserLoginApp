@page "/users/{UserId:guid}/roles"
@attribute [Authorize]
@inject ApiService Api
@inject NavigationManager Navigation

<PageTitle>Assign Roles</PageTitle>

<div class="d-flex align-items-center mb-3">
    <a href="/users" class="btn btn-sm btn-outline-secondary me-2">← Back</a>
    <h4 class="mb-0">Assign Roles — @_username</h4>
</div>

@if (_loading)
{
    <div class="spinner-border"></div>
}
else
{
    <div class="row g-3">
        <div class="col-md-5">
            <div class="card">
                <div class="card-header bg-primary text-white">Current Roles</div>
                <ul class="list-group list-group-flush">
                    @if (!_assignedRoles.Any())
                    {
                        <li class="list-group-item text-muted">No roles assigned</li>
                    }
                    @foreach (var role in _assignedRoles)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @role.Name
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRole(role.Id)">Remove</button>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card">
                <div class="card-header bg-secondary text-white">Available Roles</div>
                <ul class="list-group list-group-flush">
                    @foreach (var role in _availableRoles)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @role.Name
                            <button class="btn btn-sm btn-outline-success" @onclick="() => AddRole(role.Id)">Assign</button>
                        </li>
                    }
                    @if (!_availableRoles.Any())
                    {
                        <li class="list-group-item text-muted">All roles assigned</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid UserId { get; set; }

    private string _username = string.Empty;
    private List<RoleDto> _allRoles = new();
    private List<RoleDto> _assignedRoles = new();
    private List<RoleDto> _availableRoles = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var user = await Api.GetUserAsync(UserId);
        if (user == null) { Navigation.NavigateTo("/users"); return; }
        _username = user.Username;
        _allRoles = await Api.GetRolesAsync();
        RefreshLists(user.Roles);
        _loading = false;
    }

    private void RefreshLists(List<string> assignedRoleNames)
    {
        _assignedRoles = _allRoles.Where(r => assignedRoleNames.Contains(r.Name)).ToList();
        _availableRoles = _allRoles.Where(r => !assignedRoleNames.Contains(r.Name)).ToList();
    }

    private async Task AddRole(Guid roleId)
    {
        await Api.AssignUserRoleAsync(UserId, roleId);
        await Reload();
    }

    private async Task RemoveRole(Guid roleId)
    {
        await Api.RemoveUserRoleAsync(UserId, roleId);
        await Reload();
    }

    private async Task Reload()
    {
        var user = await Api.GetUserAsync(UserId);
        if (user != null) RefreshLists(user.Roles);
    }
}

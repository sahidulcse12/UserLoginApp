@page "/users/create"
@page "/users/edit/{Id:guid}"
@attribute [Authorize]
@inject ApiService Api
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Edit User" : "New User")</PageTitle>

<div class="d-flex align-items-center mb-3">
    <a href="/users" class="btn btn-sm btn-outline-secondary me-2">← Back</a>
    <h4 class="mb-0">@(IsEdit ? "Edit User" : "New User")</h4>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<div class="card" style="max-width:500px">
    <div class="card-body">
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            @if (!IsEdit)
            {
                <div class="mb-3">
                    <label class="form-label">Username <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="_model.Username" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password <span class="text-danger">*</span></label>
                    <InputText type="password" class="form-control" @bind-Value="_model.Password" />
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label">New Password <small class="text-muted">(leave blank to keep current)</small></label>
                    <InputText type="password" class="form-control" @bind-Value="_updateModel.NewPassword" />
                </div>
            }

            <div class="mb-3">
                <label class="form-label">First Name <span class="text-danger">*</span></label>
                @if (!IsEdit)
                {
                    <InputText class="form-control" @bind-Value="_model.FirstName" />
                }
                else
                {
                    <InputText class="form-control" @bind-Value="_updateModel.FirstName" />
                }
            </div>
            <div class="mb-3">
                <label class="form-label">Last Name <span class="text-danger">*</span></label>
                @if (!IsEdit)
                {
                    <InputText class="form-control" @bind-Value="_model.LastName" />
                }
                else
                {
                    <InputText class="form-control" @bind-Value="_updateModel.LastName" />
                }
            </div>
            <div class="mb-3">
                <label class="form-label">Email <span class="text-danger">*</span></label>
                @if (!IsEdit)
                {
                    <InputText class="form-control" @bind-Value="_model.Email" />
                }
                else
                {
                    <InputText class="form-control" @bind-Value="_updateModel.Email" />
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_loading">
                    @if (_loading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    @(IsEdit ? "Save Changes" : "Create User")
                </button>
                <a href="/users" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEdit => Id.HasValue;
    private CreateUserModel _model = new();
    private UpdateUserModel _updateModel = new();
    private bool _loading;
    private string _error = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsEdit) return;
        var user = await Api.GetUserAsync(Id!.Value);
        if (user != null)
        {
            _updateModel.Email = user.Email;
            _updateModel.FirstName = user.FirstName;
            _updateModel.LastName = user.LastName;
        }
    }

    private async Task HandleSubmit()
    {
        _loading = true;
        _error = string.Empty;

        var (success, error) = IsEdit
            ? await Api.UpdateUserAsync(Id!.Value, _updateModel)
            : await Api.CreateUserAsync(_model);

        if (success)
            Navigation.NavigateTo("/users");
        else
            _error = string.IsNullOrEmpty(error) ? "An error occurred." : error;

        _loading = false;
    }
}
